# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth（Google Cloud Console → 認証情報 から取得）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 管理者メールアドレス（カンマ区切り）
ADMIN_EMAILS=

# Supabase（Supabase ダッシュボード → Project Settings → API から取得）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe（Stripe ダッシュボード → 開発者 → API キー から取得）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# テストモード（true で Stripe テスト環境を使用・実課金なし）
NEXT_PUBLIC_DEV_TEST_MODE=false
